# =====================================================================
# MANDIQ APMC FairProcure Platform — Environment Configuration Template
# =====================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# DO NOT commit .env containing real credentials or secrets to version control.
# =====================================================================

# ---------------------------------------------------------------------
# Application Environment
# ---------------------------------------------------------------------
APP_NAME=MANDIQ APMC FairProcure Platform
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Cryptographic & Security Secrets
# ---------------------------------------------------------------------
# Run `openssl rand -hex 32` to generate a high-entropy secret key for production:
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_in_production
SUPERVISOR_MASTER_PIN=1234

# ---------------------------------------------------------------------
# PostgreSQL Database Configuration
# ---------------------------------------------------------------------
POSTGRES_DB=mandiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mandiq_secure_db_password_2026
POSTGRES_PORT=5432

# In Docker Compose, the database hostname is "postgres":
DATABASE_URL=postgresql://postgres:mandiq_secure_db_password_2026@postgres:5432/mandiq

# For Local Development outside Docker:
# DATABASE_URL=postgresql://postgres:saibaba7133@localhost:5432/mandiq

# ---------------------------------------------------------------------
# CORS & Networking
# ---------------------------------------------------------------------
# Comma-separated list of allowed origins or "*" for development
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# FairProcure QR Identity Engine
# ---------------------------------------------------------------------
QR_EXPIRY_HOURS=72
QR_ISSUER=MANDIQ APMC Platform

# ---------------------------------------------------------------------
# Frontend Client Configuration
# ---------------------------------------------------------------------
VITE_API_URL=/api/v1
PORT=80
